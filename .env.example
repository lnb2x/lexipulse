# LexiPulse - Environment Configuration Example

# Groq API Configuration
# Optional: Pre-configure your Groq API Key
# VITE_GROQ_API_KEY=gsk_...

# Optional: Configure the active model pool for Groq (comma-separated list of verified Groq models)
# Supported models:
# - llama-3.3-70b-versatile (128k context, fast, highly capable)
# - llama-3.1-8b-instant (128k context, ultra-fast >750 tps, high rate-limit)
# - mixtral-8x7b-32768 (32k context, mixture of experts)
# - llama-3.2-11b-vision-preview (128k context, multimodal/vision)
# - llama-3.2-3b-preview (8k context, lightweight)
# - llama-3.2-1b-preview (8k context, lightweight)
VITE_GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,mixtral-8x7b-32768
